<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nhasach.controller.QuanLyKhachHangController">
    <center>
        <TableView fx:id="khachHangTable">
          <columns>
            <TableColumn fx:id="MaKHCol" prefWidth="75.0" text="Mã KH" />
            <TableColumn fx:id="HoTenCol" prefWidth="200.0" text="Họ Tên" />
              <TableColumn fx:id="DienThoaiCol" prefWidth="120.0" text="Điện thoại" />
              <TableColumn fx:id="EmailCol" prefWidth="200.0" text="Email" />
              <TableColumn fx:id="DiaChiCol" prefWidth="250.0" text="Địa chỉ" />
              
          </columns>
        </TableView>
    </center>
    <right>
        <VBox prefWidth="400.0" spacing="10.0">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10" />
    </padding>

            <children>
            <HBox spacing="10" alignment="CENTER_LEFT">
  				  <padding>
   		     <Insets top="10" right="10" bottom="10" left="10" />
   		 </padding>
   		 <children>
        <Label text="Tìm kiếm:" />
        		<TextField fx:id="txtTimKiem" promptText="Nhập tên hoặc số điện thoại..." />
    		</children>
				</HBox>

                <Label text="Thông tin Khách hàng">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <GridPane hgap="10.0" vgap="10.0">
                    <children>
                        <Label text="Mã KH:" />
                        <TextField fx:id="txtMaKH" GridPane.columnIndex="1" />
                        <Label text="Họ tên:" GridPane.rowIndex="1" />
                        <TextField fx:id="txtHoTen" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label text="Điện thoại:" GridPane.rowIndex="2" />
                        <TextField fx:id="txtDienThoai" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Label text="Email:" GridPane.rowIndex="3" />
                        <TextField fx:id="txtEmail" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <Label text="Địa chỉ:" GridPane.rowIndex="4" />
                        <TextField fx:id="txtDiaChi" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                    </children>
                </GridPane>
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Button onAction="#lamMoiAction" text="Làm mới" />
                        <Button onAction="#themAction" text="Thêm" />
                        <Button onAction="#suaAction" text="Sửa" />
                        <Button onAction="#xoaAction" style="-fx-background-color: #e74c3c;" text="Xóa" textFill="WHITE" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
    </right>
</BorderPane>