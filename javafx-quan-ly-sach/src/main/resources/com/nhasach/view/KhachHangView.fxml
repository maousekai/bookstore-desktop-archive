<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #2c3e50;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nhasach.controller.KhachHangController">
    <center>
        <TableView fx:id="gioHangTableKhach">
            <columns>
                <TableColumn fx:id="TenSachCol" prefWidth="350.0" text="Tên Sách" />
                <TableColumn fx:id="soLuongCol" text="Số Lượng" />
                <TableColumn fx:id="donGiaCol" text="Đơn Giá" />
                <TableColumn fx:id="thanhTienCol" text="Thành Tiền" />
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="20.0">
            <children>
                <Label text="TỔNG CỘNG:" textFill="WHITE">
                    <font><Font name="System Bold" size="36.0" /></font>
                </Label>
                <Label fx:id="lblTongTienKhach" text="0 VNĐ" textFill="#f1c40f">
                    <font><Font name="System Bold" size="48.0" /></font>
                </Label>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </HBox>
    </bottom>
    <top>
      <VBox alignment="CENTER">
         <children>
              <Label text="KÍNH CHÀO QUÝ KHÁCH" textFill="WHITE">
                  <font><Font name="System Bold" size="36.0" /></font>
              </Label>
            <Label text="Vui lòng kiểm tra hàng và số tiền thanh toán" textFill="#bdc3c7">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
         </children>
         <padding>
            <Insets bottom="10.0" top="10.0" />
         </padding>
      </VBox>
    </top>
</BorderPane>
