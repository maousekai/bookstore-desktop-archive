<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>


<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nhasach.controller.QuanLySachController"
            stylesheets="@style.css">

    <!-- Thanh tiêu đề -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding:10; -fx-background-color:#f7f7f7;">
            <Label text="📚 Quản lý sách" style="-fx-font-size:20px; -fx-font-weight:bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="🔄 Làm mới" onAction="#lamMoiAction" />
            <Button text="➕ Thêm" onAction="#themSachAction" />
            <Button text="✏️ Sửa" onAction="#suaSachAction" />
            <Button text="🗑️ Xóa" onAction="#xoaSachAction" />
        </HBox>
    </top>

    <!-- Trung tâm: danh sách sách dạng card -->
    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="🔍 Tìm kiếm:"/>
                <TextField fx:id="txtTimKiem" promptText="Nhập tên hoặc mã sách..."/>
                <Button text="Tìm" onAction="#timKiemAction"/>
            </HBox>

            <!-- FlowPane hiển thị danh sách sách -->
            <ScrollPane fitToWidth="true">
                <content>
                    <FlowPane fx:id="flowPaneSach" hgap="15" vgap="15"
                              style="-fx-background-color:#ffffff;"
                              prefWrapLength="800">
                        <padding>
                            <Insets top="10" right="10" bottom="10" left="10"/>
                        </padding>
                    </FlowPane>
                </content>
            </ScrollPane>
        </VBox>
    </center>

    <!-- Phần dưới: thông tin chi tiết -->
    <bottom>
        <HBox spacing="20" style="-fx-background-color:#fafafa;">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <!-- Thông tin chi tiết -->
            <GridPane hgap="10" vgap="8">
    <columnConstraints>
        <ColumnConstraints minWidth="120" halignment="RIGHT"/>
        <ColumnConstraints minWidth="220" halignment="LEFT"/>
    </columnConstraints>

    <Label text="Mã sách:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="maSachField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

    <Label text="Tên sách:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <TextField fx:id="tenSachField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <Label text="Đơn giá:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <TextField fx:id="donGiaField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    <Label text="Số lượng:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <TextField fx:id="soLuongField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

    <Label text="Năm xuất bản:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
    <TextField fx:id="namXBField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

    <Label text="Thể loại:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
    <ComboBox fx:id="theLoaiComboBox" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

    <Label text="Tác giả:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
    <ComboBox fx:id="tacGiaComboBox" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

    <Label text="Nhà xuất bản:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
    <ComboBox fx:id="nxbComboBox" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

    <Label text="Vị trí kệ:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
    <TextField fx:id="viTriKeField" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

    <Label text="Vị trí hàng:" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
    <TextField fx:id="viTriHangField" GridPane.rowIndex="9" GridPane.columnIndex="1"/>

    <Label text="Vị trí ngăn:" GridPane.rowIndex="10" GridPane.columnIndex="0"/>
    <TextField fx:id="viTriNganField" GridPane.rowIndex="10" GridPane.columnIndex="1"/>
</GridPane>



            <!-- Ảnh lớn -->
            <VBox alignment="CENTER" spacing="10">
                <ImageView fx:id="anhSachImageView" fitHeight="200" fitWidth="150"
                           preserveRatio="true"
                           style="-fx-border-color: gray; -fx-border-width: 1;"/>
                <Button text="📷 Chọn ảnh" onAction="#chonAnhAction"/>
            </VBox>
        </HBox>
    </bottom>

</BorderPane>
