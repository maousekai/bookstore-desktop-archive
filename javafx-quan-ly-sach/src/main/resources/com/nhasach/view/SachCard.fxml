<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:id="cardPane"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nhasach.controller.SachCardController"
            prefWidth="160" prefHeight="250"
            style="-fx-background-color:white; -fx-border-color:#ccc; -fx-border-radius:10; -fx-background-radius:10;">

    <children>
        <ImageView fx:id="anhSach" fitWidth="140" fitHeight="180" layoutX="10" layoutY="10"
                   preserveRatio="true" style="-fx-cursor:hand;"/>
        <Label fx:id="lblTenSach" layoutX="10" layoutY="195" prefWidth="140" wrapText="true"
               style="-fx-font-weight:bold;"/>
        <Label fx:id="lblGia" layoutX="10" layoutY="220" prefWidth="140"
               textFill="#e53935"/>
    </children>
</AnchorPane>
