<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nhasach.controller.BanHangController">
    <left>
        <VBox prefWidth="400.0" spacing="10.0">
            <children>
                <Label text="Tìm Kiếm Sách">
                    <font><Font name="System Bold" size="16.0" /></font>
                </Label>
                <TextField fx:id="searchField" promptText="Nhập tên sách hoặc mã sách..." />
                <TableView fx:id="sachSearchResultTable">
                    <columns>
                        <TableColumn fx:id="searchMaSachCol" text="Mã" />
                        <TableColumn fx:id="searchTenSachCol" prefWidth="200.0" text="Tên Sách" />
                        <TableColumn fx:id="searchDonGiaCol" text="Giá" />
                        <TableColumn fx:id="searchSoLuongCol" text="Tồn" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </left>
    <center>
        <VBox spacing="10.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="HÓA ĐƠN BÁN HÀNG">
                           <font><Font name="System Bold" size="24.0" /></font>
                        </Label>
                        <Button onAction="#openCustomerDisplay" text="Mở Màn hình Khách hàng" />
                    </children>
                </HBox>
                <TableView fx:id="gioHangTable">
                    <columns>
                        <TableColumn fx:id="cartTenSachCol" prefWidth="250.0" text="Tên Sách" />
                        <TableColumn fx:id="cartSoLuongCol" text="SL" />
                        <TableColumn fx:id="cartDonGiaCol" text="Đơn Giá" />
                        <TableColumn fx:id="cartThanhTienCol" text="Thành Tiền" />
                    </columns>
                </TableView>
                <HBox alignment="CENTER_RIGHT" spacing="20.0">
                    <children>
                        <Label text="TỔNG CỘNG:">
                            <font><Font name="System Bold" size="20.0" /></font>
                        </Label>
                        <Label fx:id="lblTongTien" text="0 VNĐ" textFill="#c0392b">
                            <font><Font name="System Bold" size="24.0" /></font>
                        </Label>
                    </children>
                </HBox>
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                  <Button mnemonicParsing="false" text="Chill" />
                        <Button onAction="#xoaKhoiGioHang" text="Xóa khỏi giỏ hàng" />
                        <Button onAction="#huyHoaDon" style="-fx-background-color: #e74c3c;" text="Hủy Hóa Đơn" textFill="WHITE" />
                        <Button onAction="#thanhToan" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #27ae60;" text="Thanh Toán" textFill="WHITE" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</BorderPane>
