<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.event.*?>


<BorderPane fx:id="mainPane" prefHeight="600.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nhasach.controller.MainViewController">
   <left>
      <VBox prefWidth="200.0" spacing="10.0" style="-fx-background-color: #34495e;">
         <children>
            <Label text="Menu" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </Label>
            <Button fx:id="btnBanHang" mnemonicParsing="false" onAction="#showBanHang" prefWidth="180.0" text="Bán Hàng" />
            <Button fx:id="btnQuanLySach" mnemonicParsing="false" onAction="#showQuanLySach" prefWidth="180.0" text="Quản Lý Sách" />
            <Button fx:id="btnQuanLyNhanVien" mnemonicParsing="false" onAction="#showQuanLyNhanVien" prefWidth="180.0" text="Quản Lý Nhân Viên" />
            <Button fx:id="btnBaoCao" mnemonicParsing="false" onAction="#showBaoCao" prefWidth="180.0" text="Báo Cáo" />
            <Button fx:id="btnQuanLyKhachHang" mnemonicParsing="false" onAction="#showQuanLyKhachHang" prefWidth="180.0" text="Quản Lý Khách Hàng" />
            <Button fx:id="btnQuanLyHoaDon" text="Quản lý Hóa đơn" onAction="#showQuanLyHoaDon" prefWidth="180.0" visible="false" managed="false" />

         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </left>
   <top>
      <BorderPane style="-fx-background-color: #ecf0f1;">
         <left>
            <Label text="Xin chào," BorderPane.alignment="CENTER_LEFT">
               <padding>
                  <Insets left="10.0" />
               </padding>
            </Label>
         </left>
         <right>
            <Button mnemonicParsing="false" onAction="#dangXuat" text="Đăng xuất" BorderPane.alignment="CENTER_RIGHT">
               <BorderPane.margin>
                  <Insets right="10.0" />
               </BorderPane.margin>
            </Button>
         </right>
         <center>
            <Label fx:id="lblTenNhanVien" text="Tên Nhân Viên" BorderPane.alignment="CENTER_LEFT">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
         </center>
         <padding>
            <Insets bottom="10.0" top="10.0" />
         </padding>
      </BorderPane>
   </top>
</BorderPane>